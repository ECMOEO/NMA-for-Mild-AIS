# League table
eff <- data %>% mutate(d= as.numeric(d), n = as.numeric(n))
deff <- pairwise(treat = trt,  
                 n = n,
                 event = d, 
                 data = eff, 
                 studlab = id,
                 SM = "RR") 
e.netmeta <- netmeta(deff,
                     common = FALSE,
                     random = TRUE,
                     reference.group = "BMT")
treatments <- e.netmeta$trts
league_table <- netleague(e.netmeta,
                          seq = treatments, 
                          digits = 2, 
                          bracket = "(", 
                          backtransf = TRUE, 
                          common = FALSE, 
                          label.lower = "Favors BMT", 
                          label.upper = "Favors treatment") 

