1. Global Settings 
DATA_FILE             <- "data.xlsx"                          
OUTCOME_NAME          <- "mRS 0-1"        
LEVEL_NAME            <- "treatment class level"     
ANALYSIS_SUBGROUP     <- "symptom onset"  
SUBGROUP_VAR          <- "subgroup"      

# subgroup levels (listed in chronological order, with the first one automatically serving as the baseline reference)
SUBGROUP_LEVELS       <- c("symptom onset ≤ 4.5 h", 
                           "symptom onset  4.5 h - 24 h", 
                           "symptom onset  ＞ 24 h")

REF_TREATMENT         <- "DAPT"     

2. Reading Data and Preprocessing
data_raw <- read_xlsx(DATA_FILE)
data_raw <- as.data.frame(data)
colnames(data_raw)[colnames(data_raw) %in% c("study_i", "study")] <- "study_id"
colnames(data_raw)[colnames(data_raw) %in% c("tota")]             <- "total"
colnames(data_raw)[colnames(data_raw) %in% c("events")]           <- "event"

data_filtered <- data_raw %>%
  filter(
    outcome == OUTCOME_NAME,
    analysis == ANALYSIS_SUBGROUP,
    level == LEVEL_NAME,
    .data[[SUBGROUP_VAR]] %in% SUBGROUP_LEVELS,
    !is.na(event),
    !is.na(total)
  ) %>%
  mutate(study_sub_id = paste0(study_id, "_", .data[[SUBGROUP_VAR]])) %>%
  as.data.frame()

pwise <- pairwise(
  treat = treatment,
  event = event,
  n = total,
  studlab = study_sub_id,
  data = data_filtered,
  sm = "RR",
  allstudies = TRUE
)

nma_global <- netmeta(
  pwise,
  reference.group = REF_TREATMENT,
  common = FALSE,
  random = TRUE,
  small.values = "undesirable"
)

cat(sprintf("\n=================== Global NMA model fitted successfully (%d subgroups)===================\n", 
            length(SUBGROUP_LEVELS)))

# Network Meta Regression
cat("\n=================== Network Meta Regression===================\n")
covar_trend <- as.numeric(factor(pwise[[SUBGROUP_VAR]], levels = SUBGROUP_LEVELS))

nma_reg <- netmetareg(
  nma_global,
  covar = covar_trend,
  assumption = "common"
)
print(summary(nma_reg))

# Adaptive multiple subgroup fitting, netbind merging, and Q test
cat("\n=================== Multivariate Group Fitting and Between-Group Q Test ===================\n")
nma_sub_list  <- list()
q_within_sum  <- 0
df_within_sum <- 0

sub_colors <- c("#D95F02", "#1B9E77", "#7570B3", "#E7298A", "#66A61E")[1:length(SUBGROUP_LEVELS)]

for (i in seq_along(SUBGROUP_LEVELS)) {
  lvl <- SUBGROUP_LEVELS[i]
  pw_subset <- subset(pwise, pwise[[SUBGROUP_VAR]] == lvl)
  
  if (nrow(pw_subset) > 0) {
    has_ref <- REF_TREATMENT %in% c(pw_subset$treat1, pw_subset$treat2)
    start_node <- ifelse(has_ref, REF_TREATMENT, pw_subset$treat1)
    trts_conn  <- start_node
    repeat {
      matched_rows <- pw_subset$treat1 %in% trts_conn | pw_subset$treat2 %in% trts_conn
      new_trts     <- unique(c(pw_subset$treat1[matched_rows], pw_subset$treat2[matched_rows]))
      if (length(new_trts) == length(trts_conn)) break
      trts_conn <- new_trts
    }
    
    pw_conn <- subset(pw_subset, treat1 %in% trts_conn & treat2 %in% trts_conn)
    
    if (length(trts_conn) >= 2 && nrow(pw_conn) > 0) {
      ref_grp_use <- ifelse(has_ref, REF_TREATMENT, trts_conn)
      
      nma_lvl <- netmeta(
        pw_conn, 
        reference.group = ref_grp_use, 
        common = FALSE, 
        random = TRUE,
        small.values = "undesirable"
      )
      nma_sub_list[[lvl]] <- nma_lvl
      q_within_sum  <- q_within_sum + nma_lvl$Q
      df_within_sum <- df_within_sum + nma_lvl$df.Q
      
      cat(sprintf("✓ subgroups【%s】：Successfully fitted (including intervention: %s) \n", lvl, paste(trts_conn, collapse = ", ")))
    }
  }
}
if (length(nma_sub_list) >= 2) {
  nb <- do.call(
    netbind,
    c(
      nma_sub_list,
      list(
        name = paste0("Subgroup: ", names(nma_sub_list)),
        col.study = sub_colors[1:length(nma_sub_list)],
        col.square = sub_colors[1:length(nma_sub_list)]
      )
    )
  )
  q_total    <- nma_global$Q
  q_between  <- q_total - q_within_sum
  df_total   <- nma_global$df.Q
  df_between <- max(0, df_total - df_within_sum)
  p_between  <- ifelse(df_between > 0, 1 - pchisq(q_between, df = df_between), 1)
  
cat(sprintf("\n--- Test for Subgroup Differences across %d subgroups ---\n", 
              length(nma_sub_list)))
  cat(sprintf("Q_between = %.3f, df = %d, P-value = %.4f\n", q_between, df_between, p_between))
forest(
    nb,
    reference.group = REF_TREATMENT,
    drop.reference.group = TRUE,
    spacing = 0.8,
    fontsize = 9,
    label.left = paste0("Favours ", REF_TREATMENT),
    label.right = "Favours Treatment",
    smlab = paste0("Outcome: ", OUTCOME_NAME, "\n(Analysis: ", ANALYSIS_SUBGROUP, ")")
  )
}

# Summary Table of Pairwise Comparisons Across All Networks
cat("\n=================== All treatment pairs across subgroups ===================\n")

# combn(..., 2, simplify = FALSE) makes a list.
# Each list item contains exactly two treatment names.
trts_all <- as.character(nma_global$trts)
pair_list <- combn(trts_all, 2, simplify = FALSE)

# Use [1] to select one subgroup name, not the whole vector.
base_lvl <- as.character(SUBGROUP_LEVELS[1])

res_rows <- vector("list", length(pair_list))

for (i in seq_along(pair_list)) {
  pair <- pair_list[[i]]
  
  # IMPORTANT: pair has length 2, so select its two elements separately.
  t1 <- as.character(pair[1])
  t2 <- as.character(pair[2])
  comp_name <- paste0(t1, " vs ", t2)
  
  row_data <- list(Comparison = comp_name)
  te_map <- list()
  se_map <- list()
  
  for (lvl in SUBGROUP_LEVELS) {
    lvl <- as.character(lvl)
    col_label <- paste0(lvl, " RR (95% CI)")
    
    if (!(lvl %in% names(nma_sub_list))) {
      row_data[[col_label]] <- "NA (no subgroup model)"
      te_map[[lvl]] <- NA_real_
      se_map[[lvl]] <- NA_real_
      next
    }
    
    sub_obj <- nma_sub_list[[lvl]]
    
    # A treatment pair can be reported only when both nodes exist in this model.
    if (!all(c(t1, t2) %in% sub_obj$trts)) {
      row_data[[col_label]] <- "NA (no path / disconnected)"
      te_map[[lvl]] <- NA_real_
      se_map[[lvl]] <- NA_real_
      next
    }
    
    # TE.random is the log risk ratio; seTE.random is its standard error.
    te_val <- unname(sub_obj$TE.random[t1, t2])
    se_val <- unname(sub_obj$seTE.random[t1, t2])
    
    if (length(te_val) != 1 || length(se_val) != 1 ||
        !is.finite(te_val) || !is.finite(se_val) || se_val <= 0) {
      row_data[[col_label]] <- "NA (not estimable)"
      te_map[[lvl]] <- NA_real_
      se_map[[lvl]] <- NA_real_
      next
    }
    
    # exp() converts log RR back to OR.
    rr_val <- exp(te_val)
    ci_low <- exp(te_val - 1.96 * se_val)
    ci_upp <- exp(te_val + 1.96 * se_val)
    
    # A.matrix counts direct evidence for a treatment pair.
    has_direct <- FALSE
    if (!is.null(sub_obj$A.matrix) &&
        all(c(t1, t2) %in% rownames(sub_obj$A.matrix)) &&
        all(c(t1, t2) %in% colnames(sub_obj$A.matrix))) {
      has_direct <- isTRUE(sub_obj$A.matrix[t1, t2] > 0)
    }
    
    tag <- if (has_direct) "" else " (Indirect)"
    row_data[[col_label]] <- sprintf(
      "%.3f [%.3f, %.3f]%s",
      rr_val, ci_low, ci_upp, tag
    )
    
    te_map[[lvl]] <- te_val
    se_map[[lvl]] <- se_val
  }
  
  # RRR compares the same treatment effect between two subgroups.
  # RRR = RR(target subgroup) / RR(baseline subgroup).
  rrr_strings <- character(0)
  
  if (length(SUBGROUP_LEVELS) >= 2) {
    te_base <- te_map[[base_lvl]]
    se_base <- se_map[[base_lvl]]
    
    for (k in 2:length(SUBGROUP_LEVELS)) {
      target_lvl <- as.character(SUBGROUP_LEVELS[k])
      te_target <- te_map[[target_lvl]]
      se_target <- se_map[[target_lvl]]
      
      if (is.finite(te_target) && is.finite(se_target) &&
          is.finite(te_base) && is.finite(se_base) &&
          se_target > 0 && se_base > 0) {
        diff_te <- te_target - te_base
        diff_se <- sqrt(se_target^2 + se_base^2)
        rrr_val <- exp(diff_te)
        rrr_low <- exp(diff_te - 1.96 * diff_se)
        rrr_upp <- exp(diff_te + 1.96 * diff_se)
        p_inter <- 2 * pnorm(-abs(diff_te / diff_se))
        p_text <- ifelse(p_inter < 0.001, "<0.001", sprintf("%.4f", p_inter))
        
        rrr_strings <- c(
          rrr_strings,
          sprintf(
            "%s vs %s: RRR=%.3f [%.3f, %.3f], P=%s",
            target_lvl, base_lvl, rrr_val, rrr_low, rrr_upp, p_text
          )
        )
      } else {
        rrr_strings <- c(
          rrr_strings,
          sprintf("%s vs %s: NA", target_lvl, base_lvl)
        )
      }
    }
  }
  
  row_data[["Pairwise_RRR_vs_Baseline"]] <- paste(rrr_strings, collapse = " | ")
  res_rows[[i]] <- as.data.frame(
    row_data,
    check.names = FALSE,
    stringsAsFactors = FALSE
  )
}

# bind_rows() combines the list of one-row data frames into one table.
final_comprehensive_table <- dplyr::bind_rows(res_rows)





