==== Global Settings ===
OUTCOME_NAME   <- "mRS 0-1"    
LEVEL_NAME     <- "treatment class level"    
SUBGROUP_VAR   <- "subgroup"      
STUDY_ID_VAR   <- "study_id"     
TREATMENT_VAR  <- "treatment"     
EVENTS_VAR     <- "events"        
TOTAL_VAR      <- "total"       
REF_TREATMENT  <- "IVT"          
COMPARISONS    <- c("BMT", "SAPT", "DAPT") 
ANALYSIS_SUBGROUP <- "severity"

==== Data analysis ====
data_full <- read_xlsx("data.xlsx")

d <- data_full %>%
  filter(
    analysis == ANALYSIS_SUBGROUP,
    outcome  == OUTCOME_NAME,
    level    == LEVEL_NAME,
    criteria == SENSITIVITY
  )

d$subgroup <- relevel(
  factor(d$subgroup),
  ref = "Nondisabling"
)

pw <- d %>%
  group_by(!!sym(STUDY_ID_VAR), !!sym(SUBGROUP_VAR)) %>%
  filter(REF_TREATMENT %in% !!sym(TREATMENT_VAR)) %>%
  group_map(~ {
    ivt    <- .x %>% filter(!!sym(TREATMENT_VAR) == REF_TREATMENT)
    others <- .x %>% filter(!!sym(TREATMENT_VAR) != REF_TREATMENT)
    if (nrow(ivt) == 0 || nrow(others) == 0) return(tibble())
    ivt <- ivt[1, ]
    tibble(
      studlab  = paste(.y[[STUDY_ID_VAR]], .y[[SUBGROUP_VAR]], sep = " | "),
      treat    = others[[TREATMENT_VAR]],
      event.e  = as.numeric(others[[EVENTS_VAR]]),
      n.e      = as.numeric(others[[TOTAL_VAR]]),
      event.c  = as.numeric(ivt[[EVENTS_VAR]]),
      n.c      = as.numeric(ivt[[TOTAL_VAR]]),
      subgroup = .y[[SUBGROUP_VAR]]
    )
  }) %>%
  bind_rows()

tmp <- pw %>% filter(treat == COMPARISONS[1])
if (nrow(tmp) >= 2) {
  m_COMPARISONS1 <- metabin(
    event.e = event.e, n.e = n.e,
    event.c = event.c, n.c = n.c,
    studlab = studlab, data = tmp,
    sm = "RR", method = "Inverse", method.tau = "DL",
    common = FALSE, random = TRUE,
    subgroup = subgroup, test.subgroup = TRUE,
    prediction = TRUE, digits = 2, warn = FALSE
  )}


