extract <- function(m, treatment) {
  if (is.null(m)) return(tibble())
  overall <- tibble(
    Outcome    = OUTCOME_NAME,
    Treatment  = treatment,
    Subgroup   = "Overall",
    Studies    = m$k,
    RR         = round(exp(m$TE.random), 3),
    Lower_95CI = round(exp(m$lower.random), 3),
    Upper_95CI = round(exp(m$upper.random), 3),
    P_value    = format.pval(m$pval.random, eps = 0.001),
    I2         = paste0(round(m$I2, 1), "%"),
    tau2       = round(m$tau2, 3),
    Subgroup_P = ifelse(!is.null(m$pval.Q.b.random),
                        format.pval(m$pval.Q.b.random, eps = 0.001), NA)
  )
  if (!is.null(m$TE.random.w)) {
    sub <- tibble(
      Outcome    = OUTCOME_NAME,
      Treatment  = treatment,
      Subgroup   = as.character(m$bylevs),
      Studies    = as.integer(m$k.w),
      RR         = round(exp(m$TE.random.w), 3),
      Lower_95CI = round(exp(m$lower.random.w), 3),
      Upper_95CI = round(exp(m$upper.random.w), 3),
      P_value    = format.pval(as.vector(m$pval.random.w), eps = 0.001),
      I2         = paste0(round(as.vector(m$I2.w), 1), "%"),
      tau2       = round(as.vector(m$tau2.w), 3),
      Subgroup_P = NA
    )
    bind_rows(overall, sub)
  } else {
    overall
  }
}

summary_table <- bind_rows(
  extract(m_COMPARISONS1,  COMPARISONS[1]),
  extract(m_COMPARISONS2, COMPARISONS[2]),
  extract(m_COMPARISONS3, COMPARISONS[3])
)

cat("\n=== Summary Table ===\n")
print(summary_table, n = Inf)
